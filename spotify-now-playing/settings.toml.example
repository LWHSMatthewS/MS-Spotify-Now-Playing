# Copy this file to settings.toml on your CIRCUITPY drive and fill in your values.
# NEVER commit your real settings.toml: it holds passwords and Spotify secrets.

WIFI_SSID_1 = "your_wifi_name"
WIFI_PASSWORD_1 = "your_wifi_password"
# Optional backup networks, tried in order
WIFI_SSID_2 = ""
WIFI_PASSWORD_2 = ""
WIFI_SSID_3 = ""
WIFI_PASSWORD_3 = ""

# From developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID = "your_client_id"
SPOTIFY_CLIENT_SECRET = "your_client_secret"
SPOTIFY_REDIRECT_URI = "https://example.com/callback"

# Leave empty the first time. The board prints the value to paste here.
SPOTIFY_REFRESH_TOKEN = ""
